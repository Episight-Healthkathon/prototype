# Copy to apps/api/.env to override defaults. Never commit the real .env.
EPISIGHT_ENV=dev
EPISIGHT_DATABASE_URL=postgresql+psycopg://episight:episight@localhost:5433/episight
EPISIGHT_LOG_LEVEL=INFO

# --- AI planner (D-07, D-18) -------------------------------------------------------------
# Set ONE key; FULL mode then uses the AI planner. Without a key, every step uses the rule fallback.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# auto (default) = Anthropic if its key is set, else OpenAI, else none. Or force: anthropic | openai | none
# EPISIGHT_LLM_PROVIDER=auto
# Defaults: claude-opus-5-5 (Anthropic) / gpt-4o (OpenAI). Set this if your account uses another model.
# EPISIGHT_LLM_MODEL=
# Anthropic only: low | medium | high
# EPISIGHT_LLM_EFFORT=low
# EPISIGHT_LLM_TIMEOUT_S=30
# off = call the model and record responses; replay = answer only from recordings (regression)
# EPISIGHT_LLM_REPLAY=off
